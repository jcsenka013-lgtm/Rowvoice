{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "rowvoice-site",
  // Pinned to the Cloudflare account that owns rowvoice.com so a deploy while logged in
  // to another account fails instead of creating copies there.
  "account_id": "76e22566b7b6d6f06bd34e2732e1cc0f",
  "compatibility_date": "2026-09-01",
  "routes": [
    { "pattern": "rowvoice.com", "custom_domain": true },
    { "pattern": "www.rowvoice.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}

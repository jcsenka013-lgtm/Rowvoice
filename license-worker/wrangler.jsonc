{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rowvoice-license",
	// Pinned to the Cloudflare account that owns rowvoice.com so a deploy while logged in
	// to another account fails instead of creating copies there.
	"account_id": "76e22566b7b6d6f06bd34e2732e1cc0f",
	"main": "src/index.js",
	"compatibility_date": "2026-09-01",
	"observability": {
		"enabled": true
	},
	// Served at https://api.rowvoice.com (DNS record + certificate are created on deploy).
	"routes": [
		{
			"pattern": "api.rowvoice.com",
			"custom_domain": true
		}
	],
	"kv_namespaces": [
		// Create with: npx wrangler kv namespace create LICENSES   (then paste the id here)
		{
			"binding": "LICENSES",
			"id": "bb519484c962440ab40149b2288be641"
		}
	],
	"vars": {
		// Comma-separated OAuth client IDs allowed as the ID token audience.
		// Get it by running debugIdentityToken() in the Apps Script editor.
		"GOOGLE_CLIENT_IDS": "386477128189-2dk3baib3a1ln2c9l2l5jstv60db079r.apps.googleusercontent.com,148675355160-rcolcj6v180gul3tgorleplqqmbcski9.apps.googleusercontent.com",
		// Where Stripe's billing portal sends users back to.
		"PORTAL_RETURN_URL": "https://rowvoice.com/",
		// Stripe customer portal configuration (LIVE mode, created for launch).
		"PORTAL_CONFIGURATION_ID": "bpc_1UIB9SEG42DmppHvodSPp0tV"
	}
	// Secrets (not in this file):
	//   npx wrangler secret put STRIPE_WEBHOOK_SECRET
	//   npx wrangler secret put STRIPE_SECRET_KEY   (restricted key with billing portal write access is enough)
}